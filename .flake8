[flake8]
ignore = E111,E114,E129,E402,E501,W504,E731
exclude =
    .hg,
    .git,
    .pyenv,
    __pycache__,
    .pytest_cache,
    .ruff_cache,
    .tox,
    .venv,
    dist,
    logs,
    **/__pycache__,
    **/*.egg-info,
    hsf-coverage,
    hsf-cs.app.osx.plist-coverage.lcov,
    hsf-cs.app.osx.plist-coverage.json,
    hsf-cs.app.osx.plist-coverage.xml,
    .hsf-coverage

filename =
    lib/python/cs/app/osx/plist.py,
    lib/python/cs/ansi_colour.py,
    lib/python/cs/context.py,
    lib/python/cs/dateutils.py,
    lib/python/cs/deco.py,
    lib/python/cs/gimmicks.py,
    lib/python/cs/lex.py,
    lib/python/cs/logutils.py,
    lib/python/cs/obj.py,
    lib/python/cs/pfx.py,
    lib/python/cs/py/func.py,
    lib/python/cs/py3/_for3.py,
    lib/python/cs/seq.py,
    lib/python/cs/sh.py,
    lib/python/cs/typingutils.py,
    lib/python/cs/x.py,

indent-size = 2

# Add flake8 config -
# Irrelevant warnings; buggy warnings (E129); cannot perform inline
# suppression in some places because there is already a pylint inline
# suppression (E731) -
